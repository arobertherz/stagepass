{
  "name": "@stagepass/modules",
  "version": "2.2.0",
  "description": "Modular feature extensions for Stagepass",
  "type": "module",
  "main": "dist/all.min.js",
  "types": "global.d.ts",
  "files": [
    "dist",
    "global.d.ts",
    "inject.d.ts",
    "cookies.d.ts",
    "maintenance.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run && npm run typecheck",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p fixtures/tsconfig.json && tsc --noEmit -p fixtures/tsconfig.cookies.json && tsc --noEmit -p fixtures/tsconfig.none.json"
  },
  "keywords": [
    "stagepass",
    "modules",
    "webflow",
    "injector"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arobertherz/stagepass.git",
    "directory": "packages/modules"
  },
  "license": "MIT",
  "peerDependencies": {
    "@stagepass/loader": ">=2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  }
}
