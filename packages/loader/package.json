{
  "name": "@stagepass/loader",
  "version": "2.3.0-beta.0",
  "description": "Universal loader for Stagepass - injects local files into Webflow projects",
  "main": "dist/loader.min.js",
  "types": "global.d.ts",
  "type": "module",
  "files": [
    "dist",
    "global.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run && npm run typecheck",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p fixtures/tsconfig.json"
  },
  "keywords": [
    "webflow",
    "loader",
    "stagepass",
    "development",
    "injection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arobertherz/stagepass.git",
    "directory": "packages/loader"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^24.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  }
}
