# Copy this file to the project root as ".env" and edit the values.
# This is the main place to configure origins, limits, and the environment.
# Never commit real secrets. This boilerplate does not send mail.

# "local" or "production". The "boom" test action is only registered when local.
APP_ENV=production

# Exact origins allowed to call POST actions and to receive CORS headers.
# Comma-separated, no trailing slashes, include the scheme.
# Local Stagepass: https://your-project.sp
# Webflow preview or live site: https://your-site.webflow.io,https://www.example.com
ALLOWED_ORIGINS=https://your-project.sp,https://your-site.webflow.io

# Hidden form field. If it is filled in, the request is treated as a bot
# and a generic success is returned without running the handler.
HONEYPOT_FIELD=website

# Maximum accepted requests per IP and action within the window (seconds).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60

# JSON / form body size cap in bytes.
MAX_BODY_BYTES=65536

APP_TIMEZONE=Europe/Berlin
