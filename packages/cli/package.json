{
  "name": "@stagepass/cli",
  "version": "2.4.1",
  "description": "Local Development Orchestrator for Webflow",
  "type": "module",
  "main": "bin/index.js",
  "bin": {
    "stagepass": "./bin/index.js"
  },
  "files": [
    "bin",
    "src/cli.js",
    "src/commands/*.js",
    "src/lib/*.js",
    "templates",
    "README.md",
    "TESTING-macos.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/index.js",
    "build": "echo 'No build step required for CLI package'",
    "prepack": "node ../../scripts/sync-cli-versions.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "webflow",
    "development",
    "local",
    "proxy",
    "ssl",
    "caddy",
    "hot-reload"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arobertherz/stagepass.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "chalk": "^5.3.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.4.1",
    "ora": "^9.0.0",
    "sudo-prompt": "^9.2.1"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
